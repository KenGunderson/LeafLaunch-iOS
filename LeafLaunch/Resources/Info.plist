<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.lltemplate</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>leaflaunch</string>
			</array>
		</dict>
	</array>
	<key>Environment</key>
	<string>$(APP_ENVIRONMENT)</string>
	<key>LeafLaunchBusinessId</key>
	<string>$(LEAFLAUNCH_BUSINESS_ID)</string>
	<key>LeafLaunchAppKey</key>
	<string>$(LEAFLAUNCH_APP_KEY)</string>
	<key>LeafLaunchLogoAssetName</key>
	<string>$(LEAFLAUNCH_LOGO_ASSET_NAME)</string>
	<key>LeafLaunchDevelopmentAPIURL</key>
	<string>$(LEAFLAUNCH_DEVELOPMENT_API_URL)</string>
	<key>LeafLaunchProductionAPIURL</key>
	<string>$(LEAFLAUNCH_PRODUCTION_API_URL)</string>
	<key>LeafLaunchBundleIdentifier</key>
	<string>$(LEAFLAUNCH_BUNDLE_IDENTIFIER)</string>
	<key>FIREBASE_ANALYTICS_COLLECTION_ENABLED</key>
	<false/>
	<key>FirebaseAutomaticScreenReportingEnabled</key>
	<false/>
	<key>FirebaseCrashlyticsCollectionEnabled</key>
	<false/>
	<key>UIDesignRequiresCompatibility</key>
	<true/>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Your location is used to fill your ZIP code and sort nearby stores by distance.</string>
</dict>
</plist>
